    "anchor_summary":  {"label": "アンカー動作の具体", "window": 6},
    "item_summary":    {"label": "象徴アイテムの具体物", "window": 10},
    "phrase_summary":  {"label": "象徴フレーズ（エコー台詞・締めの言葉）", "window": 10},
