    "chord":     {"file": "emotions.json", "key": "chords", "n": 4, "window": 4,
                  "label": "感情の和音（両価感情。単色で泣かせない）"},
    "ending":    {"file": "structure.json", "key": "endings", "n": 3, "window": 3,
