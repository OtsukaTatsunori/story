    "season":    {"file": "structure.json", "key": "seasons", "n": 3, "window": 2,
                  "label": "季節"},
    "wave":      {"file": "structure.json", "key": "waves", "n": 3, "window": 3,
                  "label": "時間構造（波形）"},
    "bead":      {"file": "beads.json", "key": "items", "n": 7, "window": 0,
