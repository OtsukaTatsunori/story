    "anchor":    {"file": "anchors.json", "key": "items", "n": 4, "window": 6,
                  "label": "アンカー動作（気づきの瞬間に並走する日常動作）"},
    "viewpoint": {"file": "structure.json", "key": "viewpoints", "n": 3, "window": 2,
